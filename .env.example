# Copy to .env and fill in. See README.md for how to create the Google client ID.

# Name of the business being assessed (used on first start; can be changed in Settings)
ORG_NAME=Our organisation

# OAuth 2.0 Web client ID from Google Cloud Console (no client secret needed)
GOOGLE_CLIENT_ID=client_id1234.apps.googleusercontent.com

# Who can sign in (comma separated). Admins can also add users from the Users page.
ADMIN_EMAILS=you@example.com
ALLOWED_EMAILS=

# Optional: let anyone in these Google Workspace domains sign in (comma separated)
ALLOWED_DOMAINS=

# Long random string used to sign session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Session length in hours
SESSION_HOURS=12

# Set to false ONLY if you serve the app over plain http (e.g. http://localhost).
# Behind an HTTPS reverse proxy, leave as true.
COOKIE_SECURE=true


# Behind a reverse proxy, set this so rate limits see each user's real IP address
# instead of the proxy's. Examples: 1 (one proxy hop), or the proxy's IP/subnet.
# Leave unset if users connect to the app directly.
# TRUST_PROXY=1
