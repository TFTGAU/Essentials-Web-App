# Copy to .env and fill in. See README.md for how to create the Google client ID.

# Name of the business being assessed (used on first start; can be changed in Settings)
ORG_NAME=Our organisation

# OAuth 2.0 Web client ID from Google Cloud Console (no client secret needed)
GOOGLE_CLIENT_ID=client_id1234.apps.googleusercontent.com

# Who can sign in (comma separated). Admins can also add users from the Users page.
ADMIN_EMAILS=you@example.com
ALLOWED_EMAILS=

# Optional: let anyone in these Google Workspace domains sign in (comma separated)
ALLOWED_DOMAINS=

# Session length in hours
SESSION_HOURS=12

# Port the app is served on
PORT=8080

# Behind an HTTPS reverse proxy, set this so the app sees each user's real IP address
# and knows the connection is HTTPS (which makes sign-in cookies HTTPS-only).
# Examples: 1 (one proxy hop), or the proxy's IP/subnet. Leave unset if users connect directly.
# TRUST_PROXY=1
